page {
  background: #F5F5FA;
}
.page-index {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 搜索区 */
.search-section {
  background: linear-gradient(135deg, #1A1A2E 0%, #16213E 50%, #0F3460 100%);
  padding: 60rpx 30rpx 80rpx;
  border-radius: 0 0 40rpx 40rpx;
}
.logo-area {
  text-align: center;
  margin-bottom: 48rpx;
}
.logo-icon {
  font-size: 64rpx;
}
.logo-text {
  display: block;
  font-size: 48rpx;
  font-weight: 800;
  color: #fff;
  letter-spacing: 4rpx;
  margin-top: 8rpx;
}
.logo-sub {
  display: block;
  font-size: 24rpx;
  color: rgba(255,255,255,0.6);
  margin-top: 8rpx;
}
.search-box {
  display: flex;
  align-items: center;
  background: rgba(255,255,255,0.15);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s;
}
.search-box.focused {
  background: #fff;
  border-color: #4A90D9;
}
.search-box.focused .search-input {
  color: #333;
}
.search-box.focused .search-icon {
  color: #999;
}
.search-icon, .camera-icon, .clear-btn {
  font-size: 36rpx;
  color: rgba(255,255,255,0.6);
  padding: 0 8rpx;
}
.search-box.focused .search-icon,
.search-box.focused .camera-icon,
.search-box.focused .clear-btn {
  color: #999;
}
.clear-btn {
  font-size: 28rpx;
  color: #999;
  padding: 8rpx 16rpx;
}
.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #fff;
  padding: 0 16rpx;
  height: 48rpx;
}
.search-box.focused .search-input::placeholder {
  color: #bbb;
}

/* 建议列表 */
.suggestions {
  margin-top: 20rpx;
}
.suggestion-item {
  display: flex;
  align-items: center;
  background: rgba(255,255,255,0.1);
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 8rpx;
}
.sug-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}
.sug-info {
  flex: 1;
}
.sug-name {
  display: block;
  font-size: 28rpx;
  color: #fff;
  font-weight: 500;
}
.sug-cat {
  display: block;
  font-size: 22rpx;
  color: rgba(255,255,255,0.5);
  margin-top: 4rpx;
}
.sug-status {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}
.sug-status.allow { background: rgba(34,197,94,0.2); color: #22c55e; }
.sug-status.deny { background: rgba(239,68,68,0.2); color: #ef4444; }
.sug-status.cond { background: rgba(245,158,11,0.2); color: #f59e0b; }

/* 通用区块 */
.section {
  padding: 30rpx;
}
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}
.clear-history {
  font-size: 24rpx;
  color: #999;
  padding: 8rpx 16rpx;
}

/* 标签 */
.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.tag {
  background: #fff;
  border: 2rpx solid #eee;
  border-radius: 20rpx;
  padding: 12rpx 28rpx;
  font-size: 26rpx;
  color: #555;
}
.tag:active {
  background: #f0f0f0;
}

/* 历史 */
.history-list {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}
.history-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 30rpx;
  font-size: 26rpx;
  color: #555;
  border-bottom: 1rpx solid #f0f0f0;
}
.history-item:last-child {
  border-bottom: none;
}
.history-item:active {
  background: #f8f8f8;
}

/* 功能卡片 */
.feature-card {
  margin: 30rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
}
.feature-item {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  margin-bottom: 28rpx;
}
.feature-item:last-child { margin-bottom: 0; }
.feature-icon { font-size: 44rpx; }
.feature-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}
.feature-desc {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}
