.page-result {
  min-height: 100vh;
  padding-bottom: 60rpx;
}

/* 加载 */
.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}
.loader {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid #e0e0e0;
  border-top-color: #1A1A2E;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin {
  to { transform: rotate(360deg); }
}
.loading-text {
  font-size: 26rpx;
  color: #999;
  margin-top: 24rpx;
}

/* 未找到 */
.not-found {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 60rpx 60rpx;
}
.nf-icon { font-size: 80rpx; }
.nf-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-top: 24rpx;
}
.nf-desc {
  font-size: 26rpx;
  color: #999;
  margin-top: 12rpx;
  margin-bottom: 40rpx;
}
.btn-camera {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #666;
  padding: 20rpx 48rpx;
  background: none;
  border: none;
}

/* 结果头部 */
.result-header {
  background: linear-gradient(135deg, #1A1A2E, #0F3460);
  padding: 48rpx 30rpx 60rpx;
  text-align: center;
}
.header-icon { font-size: 56rpx; display: block; }
.header-cat {
  font-size: 22rpx;
  color: rgba(255,255,255,0.5);
  display: block;
  margin-top: 8rpx;
}
.header-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  display: block;
  margin-top: 8rpx;
}
.result-summary {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
  justify-content: center;
}
.result-tag {
  flex: 1;
  max-width: 280rpx;
  padding: 20rpx;
  border-radius: 16rpx;
}
.result-tag.green { background: rgba(34,197,94,0.15); }
.result-tag.red { background: rgba(239,68,68,0.15); }
.result-tag.yellow { background: rgba(245,158,11,0.15); }
.result-tag.blue { background: rgba(59,130,246,0.15); }
.tag-label {
  display: block;
  font-size: 22rpx;
  color: rgba(255,255,255,0.6);
}
.tag-value {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #fff;
  margin-top: 8rpx;
}

/* 卡片 */
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin: 20rpx 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}
.card-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}
.condition-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.condition-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}
.condition-bullet {
  color: #4A90D9;
  font-size: 28rpx;
  line-height: 1.5;
}
.condition-text {
  font-size: 26rpx;
  color: #555;
  line-height: 1.6;
  flex: 1;
}
.tips-text {
  font-size: 26rpx;
  color: #f59e0b;
  line-height: 1.6;
}

/* 操作栏 */
.action-bar {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 30rpx;
}
.btn-action {
  flex: 1;
  background: #1A1A2E;
  color: #fff;
  font-size: 26rpx;
  border-radius: 12rpx;
  padding: 22rpx 0;
  text-align: center;
  border: none;
}
.btn-action:active { opacity: 0.85; }
.btn-share { background: #0F3460; }
